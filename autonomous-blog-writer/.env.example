# Autonomous Blog Writer Configuration
# Copy this file to .env and update with your values

# ============================================================================
# LLM Provider (openai | gemini)
# ============================================================================
LLM_PROVIDER=openai

# OpenAI API Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini

# Gemini API Configuration (set when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-pro-preview
GEMINI_MODEL_FAST=gemini-1.5-flash

# ============================================================================
# Content Generation Settings (Optional)
# ============================================================================
CONTENT_WORD_TARGET=1800
CONTENT_TEMPERATURE=0.7
CONTENT_MIN_WORDS=1200
CONTENT_MAX_WORDS=2500
CONTENT_MIN_FAQS=5
CONTENT_MAX_FAQS=8

# ============================================================================
# Project-Specific Configuration
# ============================================================================
# BLOG_OUTPUT_DIR=src/content/blog
# RESEARCH_DIR=blog-planning/research
# TODO_FILE=blog-planning/BLOG_TODO.md

# ============================================================================
# Localization (Optional)
# ============================================================================
# CONTENT_LANGUAGE=es-MX
# CONTENT_MARKETS=CDMX,Guadalajara,Monterrey
# CONTENT_CURRENCY=MXN

# ============================================================================
# Brand Configuration (Optional)
# ============================================================================
# BRAND_NAME=Your Brand
# BRAND_DESCRIPTION=your brand description
# BLOG_AUTHOR=Your Name

# ============================================================================
# Advanced Settings (Optional)
# ============================================================================
# CONTENT_PARALLEL_SECTIONS=false
# LLM_TIMEOUT=600000
# LLM_RETRY_ATTEMPTS=3
# LOG_LEVEL=detailed
