# Example environment variables for Pilates Reformer Directory

# Cloudflare Configuration
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_EMAIL=your_email@example.com

# D1 Database Configuration
D1_DATABASE_ID=your_d1_database_id
D1_DATABASE_NAME=your_d1_database_name

# Convex Configuration
CONVEX_DEPLOYMENT=prod:frugal-ptarmigan-116
CONVEX_DEPLOYMENT_KEY=prod:frugal-ptarmigan-116|eyJ2MiI6IjJiYjAzNGM5NWFhOTQ1ZjVhNGE4YWI5ZDlkOWE1N2NiIn0=
CONVEX_PREVIEW_DEPLOYMENT=preview:tim-ottowitz:obelisk-e8704
CONVEX_PREVIEW_DEPLOYMENT_KEY=preview:tim-ottowitz:obelisk-e8704|eyJ2MiI6IjE2ZjZmYTZkMzFhOTQ5NWE4OTgzOWQ1NWI1ZjQ4MWI0In0=
VITE_CONVEX_URL=https://prod.frugal-ptarmigan-116.convex.cloud
VITE_CONVEX_PREVIEW_URL=https://preview.tim-ottowitz.obelisk-e8704.convex.cloud

# GitHub Configuration (optional)
GITHUB_REPO=username/repository
GITHUB_BRANCH=main
GITHUB_TOKEN=your_github_token_if_needed

# Google Maps API Configuration (required for scraping)
# Get your API key from: https://console.cloud.google.com/
# Enable: Maps JavaScript API, Places API, Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Scraping Configuration
SCRAPING_USER_AGENT=Mozilla/5.0 (compatible; PilatesDirectoryBot/1.0)

# Optional: Instagram API (for social media metrics)
# INSTAGRAM_API_KEY=your_instagram_api_key
# INSTAGRAM_API_URL=https://api.instagram.com/v1/

# Optional: Analytics
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console opportunity analyzer
GSC_SITE_URL=https://camadepilates.com/
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
